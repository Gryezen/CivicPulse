# Copy this to .env for local development (never commit the real .env).
# On Render, set these as actual Environment Variables in the dashboard instead.

# Supabase → Project Settings → Database → Connection string → "URI"
# (use the "Session pooler" or "Transaction pooler" URI, not the direct
# connection, if you're on a Render free instance — see README.md)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Any long random string — used to sign the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Optional — leave unset in production
FLASK_DEBUG=0

# Optional — powers the PolicyGyaan recommendation bridge (policy_engine.py)
# with Gemini. Leave unset to fall back to plain keyword-based ranking.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
