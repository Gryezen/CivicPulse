# Copy this to .env for local development (never commit the real .env).
# On Render, set these as actual Environment Variables in the dashboard instead.

# Supabase → Project Settings → Database → Connection string → "URI"
DATABASE_URL=postgresql://...

# Any long random string — used to sign the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=

# Optional — powers the PolicyGyaan recommendation bridge with Gemini.
GOOGLE_API_KEY=

# Optional — password for the seeded officer@civicpulse.local demo account.
DEMO_OFFICER_PASSWORD=

# Required to allow officials to self-register (see auth.py's register()).
# Distribute this out-of-band to real officials (department circular,
# onboarding email) — anyone who registers with role=official must supply
# this code exactly, or registration is rejected. If unset, official
# self-registration is disabled entirely (fails closed) — you'd need to
# promote a citizen account to official directly in the DB instead.
OFFICIAL_VERIFICATION_CODE=

# Optional — default source for policy_ingest.py's sync (see that file's
# docstring for the expected JSON shape). Also settable per-call via
# POST /api/officer/policies/sync {"source": "..."}. Can be a URL or a
# server-local file path; the URL adapter is untested against a live
# source in this repo's dev environment, see policy_ingest.py.
POLICY_SOURCE_URL=
