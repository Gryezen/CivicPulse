# Copy this to .env for local development (never commit the real .env).
# On Render, set these as actual Environment Variables in the dashboard instead.

# Supabase → Project Settings → Database → Connection string → "URI"
DATABASE_URL=postgresql://...

# Any long random string — used to sign the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_DEBUG=

# Optional — powers the PolicyGyaan recommendation bridge with Gemini.
GOOGLE_API_KEY=

# Optional — password for the seeded officer@civicpulse.local and
# pending-officer@civicpulse.local demo accounts.
DEMO_OFFICER_PASSWORD=

# Optional — password for the seeded admin@civicpulse.local demo account
# (see admin.py). Never self-registerable — this is the only account with
# role=admin unless you create more directly in the DB.
DEMO_ADMIN_PASSWORD=

# Required to allow officials to self-register via the fast-track code
# path (see auth.py's register()). Distribute this out-of-band to real
# officials (department circular, onboarding email) — anyone who
# registers with role=official and this exact code is verified instantly.
# If unset, that path is disabled — officials can still register via the
# ID-document + admin-review path (see admin.py) instead.
OFFICIAL_VERIFICATION_CODE=

# Optional — default source for policy_ingest.py's sync (see that file's
# docstring for the expected JSON shape). Also settable per-call via
# POST /api/officer/policies/sync {"source": "..."}. Can be a URL or a
# server-local file path; the URL adapter is untested against a live
# source in this repo's dev environment, see policy_ingest.py.
POLICY_SOURCE_URL=

# Required for the SMS/IVR inbound webhook (see ivr.py) to accept
# requests. Point your gateway's inbound-SMS/call webhook at
# /webhook/ivr/inbound?secret=<this value> (or send it as the
# X-IVR-Secret header). If unset, that webhook rejects everything —
# fails closed, same pattern as OFFICIAL_VERIFICATION_CODE. Not needed
# for the in-app demo at /sms-demo, which uses a separate, login-gated
# endpoint instead.
IVR_WEBHOOK_SECRET=

# Optional — enables the mock CPGRAMS-shaped ingestion bridge (see
# cpgrams_integration.py). Send it as the X-CPGRAMS-Key header on
# POST /api/integrations/cpgrams/ingest and GET /api/integrations/cpgrams/status/<id>.
# If unset, that endpoint refuses everything — fails closed, same pattern
# as IVR_WEBHOOK_SECRET/OFFICIAL_VERIFICATION_CODE above. This is a MOCK
# integration shape, not a live connection to the real CPGRAMS system —
# see that file's module docstring.
CPGRAMS_INTEGRATION_KEY=
