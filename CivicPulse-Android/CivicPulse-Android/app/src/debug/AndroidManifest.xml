<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant manifest overlay — merged on top of src/main/AndroidManifest.xml
  for debug builds only. Points the app at network_security_config.xml (this
  folder) so debug builds can reach the local dev server over plain HTTP
  without touching release's manifest/security posture at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
